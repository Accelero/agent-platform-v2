{
  "name": "hermes-manager-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../../../contracts/hermes-manager/openapi.yaml -o src/generated/api.ts && prettier --write src/generated/api.ts",
    "check:generated": "npm run generate && git diff --exit-code -- src/generated/api.ts",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/licenses.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{html,ts}\" \"scripts/*.mjs\"",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "generate:schemas": "node scripts/compile-schemas.mjs",
    "check:schemas": "node scripts/compile-schemas.mjs --check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "get-nonce": "1.0.1",
    "jsonc-parser": "3.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript-compiler": "npm:typescript@7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
